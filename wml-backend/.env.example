PORT=6001
VTEX_ACCOUNT=lojahr
VTEX_STORE_DOMAIN=lojahr.myvtex.com
VTEX_APP_KEY=
VTEX_APP_TOKEN=
VTEX_SALES_CHANNEL=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Send Payments uses https://{account}.vtexvault.com/api/payments/transactions/{transactionId}/payments.
VTEX_PUBLIC_STORE_DOMAIN=lojahr.myvtex.com
VTEX_WISHLIST_ENTITY=wishlist
# Provider configurado no wishlistContextProvider da Eitri.
VTEX_WISHLIST_CONTEXT_PROVIDER=vtex.wish-list@1.x
# Opcional: use uma pasta publicada com sections.json e content-types.json
# quando o backend for implantado separado do monorepo.
# CMS_SCHEMAS_DIR=./public/cms
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Opcional no desenvolvimento. Em homologação/produção, configure a URL
# privada de um Redis/Render Key Value para preservar sessões e cookies de
# propriedade do carrinho quando o backend reiniciar ou escalar.
REDIS_URL=
SESSION_STORE_TTL_SECONDS=86400

# Rota de teste de sessão: somente em homologação, nunca em produção.
# Gere uma chave exclusiva e mantenha-a apenas no ambiente de teste.
APP_ENV=development
SESSION_EXPIRY_TEST_ENABLED=false
SESSION_EXPIRY_TEST_KEY=
