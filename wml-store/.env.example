# Android Emulator: http://10.0.2.2:6001
# iOS Simulator/Web: http://localhost:6001
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:6001

# Domínio público que hospeda a página /favoritos/{token} e a API de compartilhamento.
# EXPO_PUBLIC_PUBLIC_STORE_URL=https://www.hoperesort.com.br

# Para testar a conta lojahr, use os valores abaixo no .env local:
# EXPO_PUBLIC_VTEX_ACCOUNT=lojahr
# EXPO_PUBLIC_VTEX_BASE_URL=https://lojahr.myvtex.com
# EXPO_PUBLIC_VTEX_CMS_URL=https://lojahr.myvtex.com
# EXPO_PUBLIC_VTEX_CMS_PROJECT_ID=lojahr-mobile-app
# EXPO_PUBLIC_VTEX_SALES_CHANNEL=1
# EXPO_PUBLIC_BACKEND_URL=https://wml-backend-lojahr.onrender.com

# SizeBay: use o Store Domain cadastrado na configuração da VTEX.
# O padrão deste app é https://www.hoperesort.com.br e o tenant é 866.
# EXPO_PUBLIC_SIZEBAY_DOMAIN=https://www.hoperesort.com.br
# EXPO_PUBLIC_SIZEBAY_STORE_ID=866

# Public VTEX reCAPTCHA clientId/site key. Never put clientSecret/API keys here.
# EXPO_PUBLIC_VTEX_RECAPTCHA_SITE_KEY=6Le...
# Mobile keys registered in VTEX Checkout for the native app platforms.
# EXPO_PUBLIC_VTEX_RECAPTCHA_ANDROID_SITE_KEY=6Lc...
# EXPO_PUBLIC_VTEX_RECAPTCHA_IOS_SITE_KEY=6Ld...

# Google OAuth Client IDs for native sign-in.
# Native sign-in requires a Web ID from the SAME Google Cloud project as the
# Android/iOS clients. Never use the website's VTEX ID as a native fallback.
# Android/iOS IDs must match this app's package/bundle and signing certificate.
# A Google credential is not a VTEX session: the store must also accept it.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=seu-client-id-android.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=seu-client-id-ios.apps.googleusercontent.com

# Browser-only override. When unset, the Web app loads VTEX's public Google ID.
# Do not reuse the native Web ID unless VTEX accepts its audience and Google
# has the exact browser redirect URI configured.
# EXPO_PUBLIC_GOOGLE_BROWSER_CLIENT_ID=seu-client-id-do-site.apps.googleusercontent.com

# Optional OAuth access-token exchange: requires an enabled VTEX headless OAuth
# integration with this provider name. It is disabled on the current lojahr account.
# EXPO_PUBLIC_VTEX_GOOGLE_PROVIDER_ID=Google

# Widde: use "false" to disable the product-video request. The store URL must
# be the same public domain configured in Widde for the product links.
# EXPO_PUBLIC_WIDDE_ENABLED=true
# EXPO_PUBLIC_WIDDE_STORE_URL=https://www.hoperesort.com.br
# EXPO_PUBLIC_WIDDE_ECOMMERCE_TOKEN=BR
