# Android Emulator: http://10.0.2.2:6001
# iOS Simulator/Web: http://localhost:6001
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:6001

# Public VTEX reCAPTCHA clientId/site key. Never put clientSecret/API keys here.
# EXPO_PUBLIC_VTEX_RECAPTCHA_SITE_KEY=6Le...

# Google OAuth Client IDs from the same Google Cloud project.
# The Web ID remains the one configured in VTEX Admin.
# The Android and iOS IDs are native credentials for this app.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=seu-client-id-android.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=seu-client-id-ios.apps.googleusercontent.com

# Usually this is "Google", matching the provider name returned by VTEX.
# EXPO_PUBLIC_VTEX_GOOGLE_PROVIDER_ID=Google
