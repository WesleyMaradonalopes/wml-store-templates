{
  "expo": {
    "name": "lojahr",
    "slug": "lojahr-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lojahr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.lojahr.store",
      "associatedDomains": [
        "applinks:www.hoperesort.com.br",
        "applinks:hoperesort.com.br"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permita que o LoJahr acesse suas fotos para buscar produtos por imagem.",
        "NSCameraUsageDescription": "Permita que o LoJahr use a câmera para buscar produtos por imagem.",
        "NSSpeechRecognitionUsageDescription": "Permita que o LoJahr reconheça sua voz para pesquisar produtos.",
        "NSMicrophoneUsageDescription": "Permita que o LoJahr use o microfone para pesquisar produtos por voz."
      }
    },
    "android": {
      "package": "br.com.lojahr.store",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.hoperesort.com.br"
            },
            {
              "scheme": "https",
              "host": "hoperesort.com.br"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0a0a0a",
          "defaultChannel": "marketing"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o LoJahr acesse suas fotos para buscar produtos por imagem.",
          "cameraPermission": "Permita que o LoJahr use a câmera para buscar produtos por imagem."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o LoJahr use o microfone para pesquisar produtos por voz.",
          "speechRecognitionPermission": "Permita que o LoJahr reconheça sua voz para pesquisar produtos."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f1dcc8f-e978-47eb-8661-3f4fa82f4b18"
      }
    },
    "owner": "wmlzx10rs-team"
  }
}
